# Source reference materials (large PDF/Excel), excluded from version control
references/

# runtime AI outputs: generated under extended/outputs/ and may contain operational data.
# Keep the directory readmes tracked; ignore everything else. (extended/USAGE.md)
extended/outputs/*
!extended/outputs/README.md
!extended/outputs/README.ko.md

# session work notes / scratch (root HANDOFF.md + _handoff/) - kept out of git (playbook docs/12 5.1)
/HANDOFF.md
_handoff/

# playbook standard clone (if cloned inside the project, never commit it)
/playbook/

# env / secrets (never commit)
.env
.env.*
!.env.example

# Python tooling
__pycache__/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# logs / cache
*.log
.cache/

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# playbook enforcement harness (installed by install-playbook.sh; local tooling, not committed)
/.claude/skills/enforcement-harness/
/.claude/skills/enforcement-rule-map/
/.claude/skills/evasion-surface-audit/
/.claude/skills/guard-hardening/
/.claude/skills/evasion-redteam/
/.claude/skills/translation-fidelity/
/.claude/skills/playbook-conformance/
/.claude/skills/playbook-setup/

# personal Claude Code instructions, never committed
CLAUDE.local.md

# personal Claude Code settings, never committed
.claude/settings.local.json

# korean-style이 설치한 파일입니다. 이 가운데 직접 고쳐도 되는 파일은 rules.md뿐입니다.
.korean-style/*
!.korean-style/rules.md
!.korean-style/defaults.sha256
.claude/skills/korean-style/
.claude/skills/korean-rewrite/
.claude/output-styles/korean-style.md
